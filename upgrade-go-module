#!/usr/bin/env python3

from dataclasses import dataclass
from pathlib import Path
from typing import Generator
import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import time


def main() -> None:
    args = parse_args()
    repos = find_git_repos(args.search_root)
    for repo in repos:
        print(f"{BLUE}processing repo {repo}{RESET}")
        try:
            process_repo(repo, args)
        except SkipRepo as e:
            print(f"skipping: {e.args[0]}")
            continue


BLUE = "\033[34m"
RESET = "\033[0m"


@dataclass
class Module:
    name: str
    version: str


@dataclass
class Args:
    modules: list[Module]
    search_root: Path
    target_branch: str
    references: list[str]
    draft: bool
    labels: list[str]
    upgrade_all: bool
    always_skip_if_no_change: bool


def parse_args() -> Args:
    parser = argparse.ArgumentParser(
        description="""
            Searches for local git repos containing Go modules, updates
            specified Go module dependencies to particular versions, then raises
            a PR with those changes.
        """
    )
    parser.add_argument(
        "--module",
        dest="modules",
        action="append",
        required=True,
        metavar="NAME@VERSION",
        help="Module to upgrade in NAME@VERSION format (can be specified multiple times)",
    )
    parser.add_argument(
        "--search-root", dest="search_root", default=os.path.abspath(os.curdir)
    )
    parser.add_argument("--target-branch", dest="target_branch")
    parser.add_argument("--reference", dest="references", action="append", default=[])
    parser.add_argument("--draft", dest="draft", action="store_true")
    parser.add_argument("--label", dest="labels", action="append", default=[])
    parser.add_argument("--upgrade-all", dest="upgrade_all", action="store_true")
    parser.add_argument(
        "--always-skip-if-no-change",
        dest="always_skip_if_no_change",
        action="store_true",
    )
    args = parser.parse_args()

    modules = []
    for module_spec in args.modules:
        parts = module_spec.split("@")
        if len(parts) != 2:
            parser.error(f"Invalid module specification '{module_spec}'. Expected format: NAME@VERSION")
        modules.append(Module(name=parts[0], version=parts[1]))

    return Args(
        modules=modules,
        search_root=args.search_root,
        target_branch=args.target_branch,
        references=args.references,
        draft=args.draft,
        labels=args.labels,
        upgrade_all=args.upgrade_all,
        always_skip_if_no_change=args.always_skip_if_no_change,
    )


def find_git_repos(root: Path) -> Generator[Path, None, None]:
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames.sort()
        if ".git" in dirnames:
            dirnames.clear()  # Don't search for nested repos.
            yield Path(dirpath)


class SkipRepo(Exception):
    pass


def process_repo(repo: Path, args: Args) -> None:
    go_mod = repo / "go.mod"
    if not os.path.isfile(go_mod):
        raise SkipRepo("no go.mod file")

    modules_to_upgrade = []
    for module in args.modules:
        current_version = dependency_version(go_mod, module.name)
        if not current_version:
            continue
        if current_version == module.version:
             continue
        modules_to_upgrade.append((module, current_version))

    if not modules_to_upgrade:
        if len(args.modules) == 1:
            raise SkipRepo("dependency absent or already at required version")
        raise SkipRepo("all dependencies absent or already at required versions")

    prompt_upgrade_repo(modules_to_upgrade, args)

    with tempfile.TemporaryDirectory(prefix="upgrade-go-module-") as tmp_repo_str:
        tmp_repo = Path(tmp_repo_str)
        remote_name = get_remote_url(repo)
        remote_url = exec(repo, ["git", "remote", "get-url", remote_name])
        exec(tmp_repo, ["git", "clone", remote_url, str(tmp_repo)])
        # TODO: shalow clone

        # Update modules_to_upgrade in case the freshly cloned repo has newer
        # versions compared to the ones we found earlier.
        go_mod = tmp_repo / "go.mod"
        updated_modules_to_upgrade = []
        for module, _ in modules_to_upgrade:
            current_version = dependency_version(go_mod, module.name)
            if current_version and current_version != module.version:
                updated_modules_to_upgrade.append((module, current_version))
        modules_to_upgrade = updated_modules_to_upgrade

        if not modules_to_upgrade:
            raise SkipRepo("all dependencies already at required versions in fresh clone")

        jira = extract_jira_ticket_from_references(args.references)
        branch_name = build_branch_name(jira, modules_to_upgrade)
        exec(tmp_repo, ["git", "checkout", "-b", branch_name])

        for module, _ in modules_to_upgrade:
            exec(tmp_repo, ["go", "get", f"{module.name}@{module.version}"])

        exec(tmp_repo, ["go", "mod", "tidy"])
        if os.path.isdir(os.path.join(tmp_repo, "vendor")):
            exec(tmp_repo, ["go", "mod", "vendor"])
        exec(tmp_repo, ["go", "mod", "tidy"])

        maybe_skip_noop_change(tmp_repo, args.always_skip_if_no_change)

        exec(tmp_repo, ["git", "add", "--all"])
        commit_message = build_commit_message(modules_to_upgrade)
        exec(tmp_repo, ["git", "commit", "--message", commit_message])

        exec(tmp_repo, ["git", "push", "-u", "origin", branch_name])

        pr_title = build_pr_title(jira, modules_to_upgrade)
        references_table_entry: str = (
            "N/A"
            if not args.references
            else "<ul>"
            + "".join(["<li>" + ref + "</li>" for ref in args.references])
            + "</ul>"
        )

        module_rows = ""
        for module, current_version in modules_to_upgrade:
            module_rows += f"| `{module.name}` | `{current_version}` | `{module.version}` |\n"

        pr_body = f"""
        This PR was automatically created by [upgrade-go-module][1].

        [1]: https://github.com/peterstace/upgrade-go-module

        | Module | Current version | Upgraded version |
        | --- | --- | --- |
        {module_rows}

        **Reference(s)**
        {references_table_entry}
        """
        pr_body = "\n".join(line.lstrip() for line in pr_body.splitlines())
        gh_args = [
            "gh",
            "pr",
            "create",
            "--body",
            pr_body,
            "--title",
            pr_title,
        ]
        for label in args.labels:
            gh_args.extend(["--label", label])
        if args.target_branch:
            gh_args.extend(["--base", args.target_branch])
        if args.draft:
            gh_args.append("--draft")
        p = subprocess.run(
            gh_args, cwd=tmp_repo, text=True, stdout=subprocess.PIPE, check=True
        )
        pr_url = p.stdout.splitlines()[-1]

        subprocess.run(["open", pr_url])

        print(f"{repo} upgrade complete")


def dependency_version(go_mod: Path, module_dependency_name: str) -> str | None:
    """
    Extracts the version of the dependency from the go.mod file, or returns
    None if the go.mod doesn't have the given dependency.
    """
    dir = os.path.dirname(go_mod)
    args = ["go", "mod", "edit", "-json"]
    p = subprocess.run(args, cwd=dir, text=True, stdout=subprocess.PIPE)
    data = json.loads(p.stdout)
    require = data["Require"]
    if not require:
        return None
    for dep in require:
        if dep["Path"] == module_dependency_name:
            version = dep["Version"]
            if not isinstance(version, str):
                raise Exception(f"unexpected version type: {version}")
            return version
    return None


def prompt_upgrade_repo(modules_to_upgrade: list[tuple[Module, str]], args: Args) -> None:
    if args.upgrade_all:
        return
    if len(modules_to_upgrade) == 1:
        module, current_version = modules_to_upgrade[0]
        msg = f"upgrade {module.name} from {current_version} to {module.version}?"
    else:
        upgrades = ", ".join(m.name for m, cv in modules_to_upgrade)
        msg = f"upgrade {len(modules_to_upgrade)} modules: {upgrades}?"
    if not yes_no(msg):
        raise SkipRepo("user skipped")


def get_remote_url(repo: Path) -> str:
    raw = exec(repo, ["git", "remote"])
    remotes = raw.splitlines()
    if len(remotes) == 0:
        raise Exception("no remotes")
    # TODO: There might be multiple remotes. Should we ask the user which one
    # they want?
    return remotes[0]


def exec(cwd: Path, args: list[str]) -> str:
    """
    Executes the command made by args inside cwd. Returns stdout.
    """
    proc = subprocess.run(args, cwd=cwd, text=True, check=True, stdout=subprocess.PIPE)
    return proc.stdout.rstrip("\n")


def maybe_skip_noop_change(repo: Path, always_skip_if_no_change: bool) -> None:
    args = ["git", "status", "--porcelain"]
    proc = subprocess.run(args, text=True, cwd=repo, check=True, stdout=subprocess.PIPE)

    ALLOWED = ("go.mod", "go.sum", "vendor/modules.txt")
    for line in proc.stdout.splitlines():
        if line not in (f" M {f}" for f in ALLOWED):
            return

    if always_skip_if_no_change:
        raise SkipRepo("noop change (always skipped)")
    msg = f"Update in {repo} only changes {ALLOWED}. Upgrade anyway?"
    if not yes_no(msg):
        raise SkipRepo("noop change (user skipped)")


def build_branch_name(jira: str | None, modules_to_upgrade: list[tuple[Module, str]]) -> str:
    parts = []
    if jira is not None:
        parts.append(jira)
    if len(modules_to_upgrade) == 1:
        module, _ = modules_to_upgrade[0]
        parts.extend(("upgrade", module.name, "to", module.version))
    else:
        parts.append("upgrade_modules")
    parts.append(str(int(time.time())))
    branch_name = "_".join(parts)
    branch_name = re.sub(r"[^.a-zA-Z0-9]", "_", branch_name)
    return branch_name


def build_pr_title(jira: str | None, modules_to_upgrade: list[tuple[Module, str]]) -> str:
    parts = []
    if jira is not None:
        parts.append(jira + ":")
    if len(modules_to_upgrade) == 1:
        module, _ = modules_to_upgrade[0]
        parts.extend(("Upgrade", module.name, "to", module.version))
    else:
        parts.append(f"Upgrade {len(modules_to_upgrade)} modules")
    return " ".join(parts)


def build_commit_message(modules_to_upgrade: list[tuple[Module, str]]) -> str:
    if len(modules_to_upgrade) == 1:
        module, _ = modules_to_upgrade[0]
        return f"Upgrade {module.name} to {module.version}"
    lines = [f"Upgrade {len(modules_to_upgrade)} modules", ""]
    for module, _ in modules_to_upgrade:
        lines.append(f"- {module.name} to {module.version}")
    return "\n".join(lines)


def yes_no(prompt: str) -> bool:
    return fzf(prompt, ["yes", "no"]) == "yes"


def fzf(prompt: str, choices: list[str]) -> str:
    if not prompt.endswith(" "):
        prompt = prompt + " "
    args = ["fzf", "--prompt", prompt, "--height", "~100%"]
    input = "\n".join(choices)
    p = subprocess.run(args, text=True, input=input, stdout=subprocess.PIPE, check=True)
    return p.stdout.strip()


def extract_jira_ticket_from_references(refs: list[str]) -> str | None:
    for ref in refs:
        tix = extract_jira_ticket_from_reference(ref)
        if tix is not None:
            return tix
    return None


def extract_jira_ticket_from_reference(ref: str) -> str | None:
    tix = ref.split("/")
    if len(tix) == 0:
        return None
    if re.match(r"[A-Z]+-\d+", tix[-1]):
        return tix[-1]
    return None


if __name__ == "__main__":
    main()
